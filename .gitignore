# IDR System - AI-ML Intelligent Dead Reckoning
# Byte-compiled / optimized
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg

# Virtual environments
venv/
.venv/
env/

# Data (large files - never commit root data directory or temporary recordings)
/data/
/recordings/
/scratch/
*.csv
*.zip
*.pbf
*.graphml
!src/idr/data/
!src/idr/data/**
src/idr/data/__pycache__/
src/idr/data/**/*.pyc

# Model checkpoints (keep root/temp ignored, track committed weights in models/)
*.pt
*.pth
*.onnx
*.tflite
!models/
!models/**

# Pytest & IDE
.pytest_cache/
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints/
notebooks/.ipynb_checkpoints/

# Environment & SSL Certs
.env
*.log
certs/

# Android build & local configuration artifacts
.gradle/
android/.gradle/
android/local.properties
android/**/build/
android/app/build/
*.apk
*.aab
*.ap_

# Reports and Results: track all markdown, figures, and plots
!reports/
!reports/**
!docs/
!docs/**
!reports/figures/*.png
!reports/figures/*.jpg
!reports/figures/*.svg
!results/figures/*.png
!results/figures/*.jpg
!results/figures/*.svg
